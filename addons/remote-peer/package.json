{
  "name": "@qiushuiai/qiushuiai-addon-remote-peer",
  "version": "0.3.5",
  "description": "通过 Iroh 提供基于客户端 ID 的节点聊天、显式配对、可靠投递和文件传输",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "runtime": {
      "entries": [
        "runtime.ts"
      ],
      "load": "startup"
    },
    "web": {
      "entries": [
        "web/index.ts"
      ]
    },
    "skills": [
      "skills"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "remote-peer",
        "path": "./skills/remote-peer"
      }
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "interop",
    "messaging",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon",
    "remote-peer"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/remote-peer",
  "dependencies": {
    "@number0/iroh": "1.1.0",
    "bonjour-service": "1.4.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "bun": ">=1.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/remote-peer"
  },
  "qiushuiai": {
    "displayName": "远程节点",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "remote",
      "agents",
      "messaging",
      "interop"
    ],
    "displayTags": [
      "远程协作",
      "智能体",
      "消息通信",
      "互操作"
    ],
    "featured": false,
    "skills": [
      "skills/remote-peer"
    ]
  }
}
