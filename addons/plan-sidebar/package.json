{
  "name": "@qiushuiai/qiushuiai-addon-plan-sidebar",
  "version": "0.1.26",
  "description": "提供右侧会话计划栏、统一的计划更新动作和 Markdown 存储",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "keywords": [
    "markdown",
    "pi-package",
    "planning",
    "qiushuiai",
    "qiushuiai-addon",
    "sidebar"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/plan-sidebar",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/plan-sidebar"
  },
  "qiushuiai": {
    "displayName": "计划侧边栏",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "planning",
      "ui",
      "markdown",
      "session",
      "core"
    ],
    "displayTags": [
      "计划",
      "界面",
      "Markdown 编辑",
      "会话",
      "核心推荐"
    ],
    "featured": true
  }
}
