{
  "name": "@qiushuiai/qiushuiai-addon-editable-table",
  "version": "0.1.5",
  "description": "在 Web 界面中编辑 Markdown 表格，并将修改后的内容插回对话",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    },
    "skills": [
      "skills"
    ]
  },
  "agents": {
    "skills": [
      {
        "name": "editable-table",
        "path": "./skills/editable-table"
      }
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "keywords": [
    "markdown-table",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon",
    "spreadsheet"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/editable-table",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/editable-table"
  },
  "qiushuiai": {
    "displayName": "可编辑表格",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "table",
      "markdown",
      "widget",
      "editor",
      "web-ui"
    ],
    "displayTags": [
      "表格",
      "Markdown 编辑",
      "组件",
      "编辑器",
      "网页界面"
    ],
    "featured": false
  }
}
