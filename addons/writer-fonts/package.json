{
  "name": "@qiushuiai/qiushuiai-addon-writer-fonts",
  "version": "0.2.1",
  "description": "在编辑器底栏切换文档字体，并内置多种中西文字体",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "editor",
    "fonts",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon",
    "typography"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/writer-fonts",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/writer-fonts"
  },
  "qiushuiai": {
    "displayName": "写作字体",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "editor",
      "fonts",
      "typography",
      "writing",
      "web-ui"
    ],
    "displayTags": [
      "编辑器",
      "字体",
      "排版",
      "写作",
      "网页界面"
    ],
    "featured": false
  }
}
