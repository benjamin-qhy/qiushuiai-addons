{
  "name": "@qiushuiai/qiushuiai-addon-kanban-editor",
  "version": "0.1.3",
  "description": "编辑工作区 .kanban.md 文件，并支持 Obsidian 风格的看板双向链接",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "kanban",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon",
    "wiki-links"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/kanban-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/kanban-editor"
  },
  "qiushuiai": {
    "displayName": "看板编辑器",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "kanban",
      "editor",
      "workspace",
      "markdown",
      "wiki-links"
    ],
    "displayTags": [
      "看板",
      "编辑器",
