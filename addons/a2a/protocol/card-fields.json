{
  "AgentCard": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "supportedInterfaces": {
      "type": "AgentInterface",
      "repeated": true,
      "required": true
    },
    "provider": {
      "type": "AgentProvider"
    },
    "version": {
      "type": "string",
      "required": true
    },
    "documentationUrl": {
      "type": "string",
      "presence": true
    },
    "capabilities": {
      "type": "AgentCapabilities",
      "required": true
    },
    "securitySchemes": {
      "type": "SecurityScheme",
      "map": true
    },
    "securityRequirements": {
      "type": "SecurityRequirement",
      "repeated": true
    },
    "defaultInputModes": {
      "type": "string",
      "repeated": true,
      "required": true
    },
    "defaultOutputModes": {
      "type": "string",
      "repeated": true,
      "required": true
    },
    "skills": {
      "type": "AgentSkill",
      "repeated": true,
      "required": true
    },
    "signatures": {
      "type": "AgentCardSignature",
      "repeated": true
    },
    "iconUrl": {
      "type": "string",
      "presence": true
    }
  },
  "AgentInterface": {
    "url": {
      "type": "string",
      "required": true
    },
    "protocolBinding": {
      "type": "string",
      "required": true
    },
    "tenant": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string",
      "required": true
    }
  },
  "AgentProvider": {
    "url": {
      "type": "string",
      "required": true
    },
    "organization": {
      "type": "string",
      "required": true
    }
  },
  "AgentCapabilities": {
    "streaming": {
      "type": "bool",
      "presence": true
    },
    "pushNotifications": {
      "type": "bool",
      "presence": true
    },
    "extensions": {
      "type": "AgentExtension",
      "repeated": true
    },
    "extendedAgentCard": {
      "type": "bool",
      "presence": true
    }
  },
  "AgentExtension": {
    "uri": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "required": {
      "type": "bool"
    },
    "params": {
      "type": "google.protobuf.Struct"
    }
  },
  "SecurityScheme": {
    "apiKeySecurityScheme": {
      "type": "APIKeySecurityScheme",
      "presence": true
    },
    "httpAuthSecurityScheme": {
      "type": "HTTPAuthSecurityScheme",
      "presence": true
    },
    "oauth2SecurityScheme": {
      "type": "OAuth2SecurityScheme",
      "presence": true
    },
    "openIdConnectSecurityScheme": {
      "type": "OpenIdConnectSecurityScheme",
      "presence": true
    },
    "mtlsSecurityScheme": {
      "type": "MutualTlsSecurityScheme",
      "presence": true
    }
  },
  "APIKeySecurityScheme": {
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    }
  },
  "HTTPAuthSecurityScheme": {
    "description": {
      "type": "string"
    },
    "scheme": {
      "type": "string",
      "required": true
    },
    "bearerFormat": {
      "type": "string"
    }
  },
  "OAuth2SecurityScheme": {
    "description": {
      "type": "string"
    },
    "flows": {
      "type": "OAuthFlows",
      "required": true
    },
    "oauth2MetadataUrl": {
      "type": "string"
    }
  },
  "OAuthFlows": {
    "authorizationCode": {
      "type": "AuthorizationCodeOAuthFlow",
      "presence": true
    },
    "clientCredentials": {
      "type": "ClientCredentialsOAuthFlow",
      "presence": true
    },
    "implicit": {
      "type": "ImplicitOAuthFlow",
      "presence": true
    },
    "password": {
      "type": "PasswordOAuthFlow",
      "presence": true
    },
    "deviceCode": {
      "type": "DeviceCodeOAuthFlow",
      "presence": true
    }
  },
  "AuthorizationCodeOAuthFlow": {
    "authorizationUrl": {
      "type": "string",
      "required": true
    },
    "tokenUrl": {
      "type": "string",
      "required": true
    },
    "refreshUrl": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "map": true,
      "required": true
    },
    "pkceRequired": {
      "type": "bool"
    }
  },
  "ClientCredentialsOAuthFlow": {
    "tokenUrl": {
      "type": "string",
      "required": true
    },
    "refreshUrl": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "map": true,
      "required": true
    }
  },
  "ImplicitOAuthFlow": {
    "authorizationUrl": {
      "type": "string"
    },
    "refreshUrl": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "map": true
    }
  },
  "PasswordOAuthFlow": {
    "tokenUrl": {
      "type": "string"
    },
    "refreshUrl": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "map": true
    }
  },
  "DeviceCodeOAuthFlow": {
    "deviceAuthorizationUrl": {
      "type": "string",
      "required": true
    },
    "tokenUrl": {
      "type": "string",
      "required": true
    },
    "refreshUrl": {
      "type": "string"
    },
    "scopes": {
      "type": "string",
      "map": true,
      "required": true
    }
  },
  "OpenIdConnectSecurityScheme": {
    "description": {
      "type": "string"
    },
    "openIdConnectUrl": {
      "type": "string",
      "required": true
    }
  },
  "MutualTlsSecurityScheme": {
    "description": {
      "type": "string"
    }
  },
  "SecurityRequirement": {
    "schemes": {
      "type": "StringList",
      "map": true
    }
  },
  "StringList": {
    "list": {
      "type": "string",
      "repeated": true
    }
  },
  "AgentSkill": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "tags": {
      "type": "string",
      "repeated": true,
      "required": true
    },
    "examples": {
      "type": "string",
      "repeated": true
    },
    "inputModes": {
      "type": "string",
      "repeated": true
    },
    "outputModes": {
      "type": "string",
      "repeated": true
    },
    "securityRequirements": {
      "type": "SecurityRequirement",
      "repeated": true
    }
  },
  "AgentCardSignature": {
    "protected": {
      "type": "string",
      "required": true
    },
    "signature": {
      "type": "string",
      "required": true
    },
    "header": {
      "type": "google.protobuf.Struct"
    }
  }
}
