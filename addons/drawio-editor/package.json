{
  "name": "@qiushuiai/qiushuiai-addon-drawio-editor",
  "version": "31.4.4",
  "description": "提供自托管的 draw.io 图表编辑器，并与工作区文件集成",
  "type": "module",
  "main": "index.ts",
  "agents": {},
  "scripts": {
    "vendor:update": "bun run scripts/vendor-drawio.ts",
    "prepack": "bun run scripts/pack-vendor.ts",
    "test": "bun test index.test.ts"
  },
  "files": [
    "index.ts",
    "web",
    "vendor.tar.gz",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/drawio-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/drawio-editor"
  },
  "qiushuiai": {
    "displayName": "draw.io 编辑器",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "diagrams",
      "editor",
      "drawio"
    ],
    "displayTags": [
      "图表",
      "编辑器",
      "draw.io 图表"
    ],
    "featured": false,
    "vendorUrl": "https://github.com/jgraph/drawio/releases",
    "vendorVersion": "31.4.2"
  }
}
