{
  "name": "@qiushuiai/qiushuiai-addon-whatsapp",
  "version": "0.1.5",
  "description": "通过 Baileys 连接 WhatsApp Web，收发消息并转交智能体处理",
  "type": "module",
  "main": "index.ts",
