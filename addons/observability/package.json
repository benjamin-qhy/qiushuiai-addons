{
  "name": "@qiushuiai/qiushuiai-addon-observability",
  "version": "0.1.19",
  "description": "通过 OpenTelemetry 将错误和智能体轮次追踪到 Azure Application Insights 和本地 Graphite",
  "type": "module",
  "main": "index.ts",
  "agents": {
    "skills": [
      {
        "name": "usage-telemetry-chart",
        "path": "./skills/usage-telemetry-chart"
      }
    ]
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "web": {
      "entries": [
        "web/index.ts"
      ]
    },
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.19",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/resources": "^2.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/observability",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/observability"
  },
  "qiushuiai": {
    "displayName": "可观测性",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "observability",
      "tracing",
      "otel",
      "opentelemetry",
      "application-insights",
      "graphite",
      "metrics",
      "live-metrics",
      "core"
    ],
    "displayTags": [
      "可观测性",
      "链路追踪",
      "遥测",
      "开放遥测",
      "应用洞察",
      "Graphite 指标",
      "指标",
      "实时指标",
      "核心推荐"
    ],
    "featured": true,
    "skills": [
      "skills/usage-telemetry-chart"
    ]
  }
}
