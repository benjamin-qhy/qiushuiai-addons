{
  "name": "@qiushuiai/qiushuiai-addon-goal",
  "version": "0.1.49",
  "description": "提供持久化线程目标、加固的自主续行循环和清晰的完成或停止摘要",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "runtime": {
      "entries": [
        "runtime.ts"
      ],
      "load": "startup"
    },
    "web": {
      "entries": [
        "web/index.ts"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "keywords": [
    "goal",
    "goal-seeking",
    "loop",
    "pi-package",
    "qiushuiai",
    "qiushuiai-addon"
  ],
  "license": "MIT",
  "homepage": "https://github.com/benjamin-qhy/qiushuiai-addons/tree/main/addons/goal",
  "repository": {
    "type": "git",
    "url": "https://github.com/benjamin-qhy/qiushuiai-addons.git",
    "directory": "addons/goal"
  },
  "qiushuiai": {
    "displayName": "目标管理",
    "type": "extension",
    "compatibleVersions": ">=3.0.0",
    "categories": [
      "automation",
      "goal-seeking",
      "loop",
      "productivity",
      "session",
      "core"
    ],
    "displayTags": [
      "自动化",
      "目标驱动",
      "自动续行",
      "效率",
      "会话",
      "核心推荐"
    ],
    "featured": true
  }
}
